{
  "name": "hledger-lsp",
  "version": "0.6.0",
  "description": "Language Server Protocol implementation for hledger plain text accounting",
  "main": "./out/server.js",
  "bin": {
    "hledger-lsp": "./out/server.js"
  },
  "files": [
    "out/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -watch -p tsconfig.build.json",
    "lint": "eslint src",
    "test": "jest --ignoreProjects conformance",
    "test:all": "jest",
    "test:watch": "jest --watch --ignoreProjects conformance",
    "test:coverage": "jest --coverage --ignoreProjects conformance",
    "test:verbose": "jest --verbose --ignoreProjects conformance",
    "test:conformance": "jest --selectProjects conformance",
    "prepare": "npm run build"
  },
  "keywords": [
    "hledger",
    "lsp",
    "language-server",
    "accounting"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ptimoney/hledger-lsp.git"
  },
  "bugs": {
    "url": "https://github.com/ptimoney/hledger-lsp/issues"
  },
  "homepage": "https://github.com/ptimoney/hledger-lsp#readme",
  "author": "Patrick Timoney",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  }
}
